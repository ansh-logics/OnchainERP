{
  "name": "onchain-erp-backend",
  "version": "1.0.0",
  "description": "Backend API for OnchainERP",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "lint": "eslint .",
    "seed:import": "node src/scripts/seed-temp.js --import",
    "seed:delete": "node src/scripts/seed-temp.js --delete",
    "seed:temp": "node src/scripts/seed-temp.js --import",
    "seed:temp:delete": "node src/scripts/seed-temp.js --delete",
    "migrate": "node src/scripts/migrate-deprecated.js",
    "db:setup": "node -e \"require('./src/config/database').connectDatabases()\"",
    "db:reset": "node -e \"require('./src/models/postgresql').sequelize.sync({force: true})\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "dotenv-expand": "^12.0.3",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.1",
    "mongoose": "^7.4.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.16.3",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^8.46.0",
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
