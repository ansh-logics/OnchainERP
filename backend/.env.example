# Environment Configuration
# PostgreSQL = structured domain data (users, colleges, courses, …)
# MongoDB = system logs + unstructured documents (file metadata, analytics, notifications, config)

# Node Environment
NODE_ENV=development
PORT=5000

# PostgreSQL — structured domain data
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=onchain_erp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# MongoDB — logs and unstructured data only (must match docker-compose DB name if local)
MONGODB_URI=mongodb://localhost:27017/onchain_erp

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d
# HttpOnly cookie lifetime in days (omit or invalid → defaults to 30)
JWT_COOKIE_EXPIRE=30

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_email_password
FROM_EMAIL=noreply@onchainerp.com
FROM_NAME=OnchainERP

# File Upload Configuration
MAX_FILE_UPLOAD=50000000
FILE_UPLOAD_PATH=./uploads

# Logging Configuration
LOG_LEVEL=info

# API Configuration
API_VERSION=v1

# Security
BCRYPT_ROUNDS=12

# Database Migration
ENABLE_MIGRATION=false
