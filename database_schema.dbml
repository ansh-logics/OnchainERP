// OnchainERP Complete Database Schema
// Designed for comprehensive ERP system as per Problem Statement 25103
// Hybrid PostgreSQL + MongoDB architecture for optimal performance

// ============================================
// POSTGRESQL TABLES (Structured Relational Data)
// ============================================

Table users {
  id uuid [primary key, default: `gen_random_uuid()`]
  name varchar(100) [not null]
  email varchar [not null, unique]
  password varchar [not null]
  role user_role [not null]
  studentId varchar [unique]
  facultyId varchar [unique]
  phone varchar(15)
  profilePicture varchar
  isActive boolean [default: true]
  isEmailVerified boolean [default: false]
  lastLogin timestamp
  resetPasswordToken varchar
  resetPasswordExpire timestamp
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    email
    role
    studentId
    facultyId
    isActive
  }
}

Table colleges {
  id uuid [primary key, default: `gen_random_uuid()`]
  name varchar(200) [not null]
  shortName varchar(20) [not null, unique]
  establishedYear integer [not null]
  affiliatedUniversity varchar [not null]
  collegeType college_type [not null]
  registrationNumber varchar [not null, unique]
  
  // Address fields
  addressStreet varchar [not null]
  addressCity varchar [not null]
  addressState varchar [not null]
  addressPincode varchar(6) [not null]
  addressCountry varchar [default: 'India']
  
  // Contact fields
  phone varchar(15) [not null]
  email varchar [not null]
  website varchar
  fax varchar
  
  // Infrastructure
  campusArea decimal(10,2) [not null, note: 'Campus area in acres']
  totalBuildings integer
  totalClassrooms integer
  totalLaboratories integer
  
  // Library details
  libraryTotalBooks integer
  libraryDigitalResources boolean [default: false]
  libraryArea integer [note: 'Library area in sq ft']
  
  // Hostel details
  totalHostels integer [default: 0]
  totalHostelRooms integer [default: 0]
  totalHostelCapacity integer [default: 0]
  
  // Admin reference
  adminId uuid [not null, ref: > users.id]
  
  // Accreditation
  naacGrade naac_grade
  naacValidUntil timestamp
  nbaAccredited boolean [default: false]
  nbaValidUntil timestamp
  
  // Academic year settings
  academicStartMonth integer [default: 7]
  academicEndMonth integer [default: 6]
  currentAcademicYear varchar [not null]
  
  isActive boolean [default: true]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    shortName
    (addressCity, addressState)
    collegeType
    adminId
    currentAcademicYear
  }
}

Table departments {
  id uuid [primary key, default: `gen_random_uuid()`]
  collegeId uuid [not null, ref: > colleges.id]
  name varchar(100) [not null]
  shortName varchar(20) [not null]
  code varchar(20) [not null, unique]
  description text [not null]
  hodId uuid [ref: > users.id]
  
  // Section configuration
  studentsPerSection integer [not null, default: 60]
  totalSections integer [not null, default: 1]
  
  // Intake capacity
  totalIntake integer [not null]
  currentStrength integer [default: 0]
  
  // Department facilities
  totalFaculty integer [default: 0]
  totalLabs integer [default: 0]
  
  isActive boolean [default: true]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    collegeId
    code
    hodId
    isActive
  }
}

Table courses {
  id uuid [primary key, default: `gen_random_uuid()`]
  collegeId uuid [not null, ref: > colleges.id]
  departmentId uuid [not null, ref: > departments.id]
  
  code varchar(20) [not null, unique]
  name varchar(200) [not null]
  shortName varchar(50)
  description text [not null]
  
  // Academic details
  credits integer [not null]
  semester integer [not null]
  courseType course_type [not null]
  
  // Course structure
  theoryHours integer [default: 0]
  labHours integer [default: 0]
  tutorialHours integer [default: 0]
  totalHours integer [not null]
  
  // Prerequisites
  prerequisites text [note: 'JSON array of prerequisite course IDs']
  
  // Assessment structure
  hasInternalAssessment boolean [default: true]
  hasFinalExam boolean [default: true]
  internalMarks integer [default: 40]
  finalMarks integer [default: 60]
  passingMarks integer [default: 40]
  
  // Faculty assignment
  primaryFacultyId uuid [ref: > faculty.id]
  
  isActive boolean [default: true]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    collegeId
    departmentId
    code
    semester
    courseType
    primaryFacultyId
  }
}

Table faculty {
  id uuid [primary key, default: `gen_random_uuid()`]
  userId uuid [not null, unique, ref: > users.id]
  collegeId uuid [not null, ref: > colleges.id]
  departmentId uuid [not null, ref: > departments.id]
  
  // Faculty identification
  employeeId varchar(20) [not null, unique]
  facultyId varchar(20) [unique]
  
  // Professional details
  designation faculty_designation [not null]
  qualification varchar(500) [not null]
  specialization varchar(200)
  experience integer [note: 'Experience in years']
  
  // Employment details
  joiningDate date [not null]
  employmentType employment_type [not null]
  salary decimal(12,2)
  
  // Personal details
  dateOfBirth date [not null]
  gender gender_type [not null]
  bloodGroup blood_group
  maritalStatus marital_status
  
  // Contact details
  personalEmail varchar
  personalPhone varchar(15)
  emergencyContact varchar(15)
  
  // Address
  addressStreet varchar
  addressCity varchar
  addressState varchar
  addressPincode varchar(6)
  addressCountry varchar [default: 'India']
  
  // Administrative roles
  isHOD boolean [default: false]
  isClassTeacher boolean [default: false]
  
  isActive boolean [default: true]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    userId
    collegeId
    departmentId
    employeeId
    facultyId
    designation
    isHOD
  }
}

Table students {
  id uuid [primary key, default: `gen_random_uuid()`]
  userId uuid [not null, unique, ref: > users.id]
  collegeId uuid [not null, ref: > colleges.id]
  departmentId uuid [not null, ref: > departments.id]
  sectionId uuid [ref: > sections.id]
  
  // Student identification
  rollNumber varchar(20) [unique]
  enrollmentNumber varchar(30) [not null, unique]
  studentId varchar(20) [unique]
  
  // Academic details
  batch varchar(10) [not null]
  program varchar(50) [not null]
  admissionYear integer [not null]
  currentSemester integer [default: 1]
  
  // Personal details
  dateOfBirth date [not null]
  gender gender_type [not null]
  bloodGroup blood_group
  category student_category [not null]
  religion varchar(50)
  nationality varchar(50) [default: 'Indian']
  
  // Contact details
  personalEmail varchar
  personalPhone varchar(15)
  
  // Permanent Address
  permanentAddressStreet varchar
  permanentAddressCity varchar
  permanentAddressState varchar
  permanentAddressPincode varchar(6)
  permanentAddressCountry varchar [default: 'India']
  
  // Current Address
  currentAddressStreet varchar
  currentAddressCity varchar
  currentAddressState varchar
  currentAddressPincode varchar(6)
  currentAddressCountry varchar [default: 'India']
  
  // Guardian details
  guardianName varchar(100) [not null]
  guardianRelation guardian_relation [not null]
  guardianPhone varchar(15) [not null]
  guardianEmail varchar
  guardianOccupation varchar(100)
  
  // Academic performance
  cgpa decimal(3,2)
  totalCredits integer [default: 0]
  
  // Hostel information
  isHostelResident boolean [default: false]
  hostelId uuid [ref: > hostels.id]
  roomId uuid [ref: > hostel_rooms.id]
  
  admissionStatus admission_status [default: 'applied']
  isActive boolean [default: true]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    userId
    collegeId
    departmentId
    sectionId
    rollNumber
    enrollmentNumber
    batch
    admissionStatus
    hostelId
    roomId
  }
}

Table sections {
  id uuid [primary key, default: `gen_random_uuid()`]
  collegeId uuid [not null, ref: > colleges.id]
  departmentId uuid [not null, ref: > departments.id]
  
  name varchar(50) [not null]
  code varchar(10) [not null, unique]
  batch varchar(10) [not null]
  semester integer [not null]
  
  // Section configuration
  maxCapacity integer [not null]
  currentStrength integer [default: 0]
  
  // Class teacher
  classTeacherId uuid [ref: > faculty.id]
  
  // Classroom assignment
  defaultClassroomId uuid [ref: > classrooms.id]
  
  isActive boolean [default: true]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    collegeId
    departmentId
    code
    batch
    semester
    classTeacherId
  }
}

Table labs {
  id uuid [primary key, default: `gen_random_uuid()`]
  collegeId uuid [not null, ref: > colleges.id]
  departmentId uuid [not null, ref: > departments.id]
  
  name varchar(100) [not null]
  labCode varchar(20) [not null, unique]
  description text
  location varchar(100)
  capacity integer
  equipment json [default: '[]']
  maintenance json [default: '[]']
  availability json [default: '{}']
  
  // Lab management
  labInchargeId uuid [ref: > faculty.id]
  
  isActive boolean [default: true]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]
  deletedAt timestamp [note: 'Soft delete']

  indexes {
    labCode [unique]
    collegeId
    departmentId
    labInchargeId
    isActive
  }
}

// ============================================
// NEW TABLES FOR COMPLETE ERP FUNCTIONALITY
// ============================================

Table hostels {
  id uuid [primary key, default: `gen_random_uuid()`]
  collegeId uuid [not null, ref: > colleges.id]
  
  name varchar(100) [not null]
  hostelCode varchar(20) [not null, unique]
  hostelType hostel_type [not null]
  gender gender_type [not null, note: 'Boys/Girls/Co-ed hostel']
  
  // Location and infrastructure
  location varchar(200)
  totalFloors integer [not null]
  totalRooms integer [not null]
  totalCapacity integer [not null]
  currentOccupancy integer [default: 0]
  
  // Facilities
  facilities json [default: '[]', note: 'Array of available facilities']
  
  // Management
  wardenId uuid [ref: > faculty.id]
  
  // Hostel fees
  monthlyFee decimal(10,2) [not null]
  securityDeposit decimal(10,2) [not null]
  
  isActive boolean [default: true]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    collegeId
    hostelCode
    hostelType
    gender
    wardenId
  }
}

Table hostel_rooms {
  id uuid [primary key, default: `gen_random_uuid()`]
  hostelId uuid [not null, ref: > hostels.id]
  
  roomNumber varchar(10) [not null]
  floor integer [not null]
  roomType room_type [not null]
  capacity integer [not null]
  currentOccupancy integer [default: 0]
  
  // Room amenities
  amenities json [default: '[]']
  
  // Room condition
  condition room_condition [default: 'good']
  lastMaintenanceDate date
  
  isActive boolean [default: true]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    hostelId
    (hostelId, roomNumber) [unique]
    roomType
    condition
  }
}

Table hostel_allocations {
  id uuid [primary key, default: `gen_random_uuid()`]
  studentId uuid [not null, ref: > students.id]
  hostelId uuid [not null, ref: > hostels.id]
  roomId uuid [not null, ref: > hostel_rooms.id]
  
  allocationDate date [not null]
  checkInDate date
  checkOutDate date
  
  // Allocation details
  academicYear varchar(10) [not null]
  semester integer [not null]
  
  // Status
  status allocation_status [default: 'allocated']
  
  // Fees
  monthlyFee decimal(10,2) [not null]
  securityDeposit decimal(10,2) [not null]
  
  // Remarks
  remarks text
  
  isActive boolean [default: true]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    studentId
    hostelId
    roomId
    academicYear
    status
    (studentId, academicYear) [unique]
  }
}

Table attendance {
  id uuid [primary key, default: `gen_random_uuid()`]
  studentId uuid [not null, ref: > students.id]
  courseId uuid [not null, ref: > courses.id]
  facultyId uuid [not null, ref: > faculty.id]
  
  attendanceDate date [not null]
  period integer [not null, note: 'Class period number']
  
  status attendance_status [not null]
  
  // Class details
  classType class_type [default: 'theory']
  topic varchar(200)
  
  // Marking details
  markedBy uuid [not null, ref: > faculty.id]
  markedAt timestamp [default: `now()`]
  
  // Modification tracking
  modifiedBy uuid [ref: > faculty.id]
  modifiedAt timestamp
  modificationReason varchar(200)
  
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    studentId
    courseId
    facultyId
    attendanceDate
    (studentId, courseId, attendanceDate, period) [unique]
    status
  }
}

Table assignments {
  id uuid [primary key, default: `gen_random_uuid()`]
  courseId uuid [not null, ref: > courses.id]
  facultyId uuid [not null, ref: > faculty.id]
  
  title varchar(200) [not null]
  description text [not null]
  instructions text
  
  // Assignment details
  assignmentType assignment_type [not null]
  maxMarks integer [not null]
  
  // Dates
  assignedDate date [not null]
  dueDate date [not null]
  submissionStartDate date [not null]
  submissionEndDate date [not null]
  
  // Submission settings
  allowLateSubmission boolean [default: false]
  lateSubmissionPenalty integer [default: 0, note: 'Percentage penalty']
  
  // File requirements
  allowedFileTypes json [default: '["pdf", "doc", "docx"]']
  maxFileSize integer [default: 10485760, note: 'Size in bytes']
  maxFiles integer [default: 1]
  
  // Status
  status assignment_status [default: 'active']
  
  isActive boolean [default: true]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    courseId
    facultyId
    assignmentType
    dueDate
    status
  }
}

Table assignment_submissions {
  id uuid [primary key, default: `gen_random_uuid()`]
  assignmentId uuid [not null, ref: > assignments.id]
  studentId uuid [not null, ref: > students.id]
  
  submissionDate timestamp [not null]
  isLateSubmission boolean [default: false]
  
  // Submission content
  submissionText text
  
  // Grading
  marksObtained integer
  feedback text
  gradedBy uuid [ref: > faculty.id]
  gradedAt timestamp
  
  // Status
  status submission_status [default: 'submitted']
  
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    assignmentId
    studentId
    (assignmentId, studentId) [unique]
    submissionDate
    status
  }
}

Table exams {
  id uuid [primary key, default: `gen_random_uuid()`]
  collegeId uuid [not null, ref: > colleges.id]
  courseId uuid [not null, ref: > courses.id]
  
  examName varchar(100) [not null]
  examType exam_type [not null]
  
  // Exam schedule
  examDate date [not null]
  startTime time [not null]
  endTime time [not null]
  duration integer [not null, note: 'Duration in minutes']
  
  // Exam details
  maxMarks integer [not null]
  passingMarks integer [not null]
  
  // Exam hall and logistics
  examHallId uuid [ref: > exam_halls.id]
  invigilatorId uuid [ref: > faculty.id]
  
  // Instructions
  instructions text
  
  // Status
  status exam_status [default: 'scheduled']
  
  isActive boolean [default: true]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    collegeId
    courseId
    examType
    examDate
    status
    examHallId
  }
}

Table exam_halls {
  id uuid [primary key, default: `gen_random_uuid()`]
  collegeId uuid [not null, ref: > colleges.id]
  
  hallName varchar(100) [not null]
  hallCode varchar(20) [not null, unique]
  location varchar(200)
  capacity integer [not null]
  
  // Hall facilities
  facilities json [default: '[]']
  
  isActive boolean [default: true]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    collegeId
    hallCode
    capacity
  }
}

Table exam_results {
  id uuid [primary key, default: `gen_random_uuid()`]
  examId uuid [not null, ref: > exams.id]
  studentId uuid [not null, ref: > students.id]
  
  marksObtained integer [not null]
  grade varchar(5)
  gradePoints decimal(3,2)
  
  // Result status
  status result_status [default: 'published']
  
  // Evaluation details
  evaluatedBy uuid [ref: > faculty.id]
  evaluatedAt timestamp
  
  // Remarks
  remarks text
  
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    examId
    studentId
    (examId, studentId) [unique]
    status
  }
}

Table library_books {
  id uuid [primary key, default: `gen_random_uuid()`]
  collegeId uuid [not null, ref: > colleges.id]
  
  // Book identification
  isbn varchar(20) [unique]
  accessionNumber varchar(20) [not null, unique]
  
  // Book details
  title varchar(500) [not null]
  author varchar(200) [not null]
  publisher varchar(200)
  edition varchar(50)
  publicationYear integer
  
  // Classification
  category varchar(100)
  subject varchar(100)
  language varchar(50) [default: 'English']
  
  // Physical details
  totalCopies integer [not null, default: 1]
  availableCopies integer [not null, default: 1]
  
  // Book condition and location
  location varchar(100)
  condition book_condition [default: 'good']
  
  // Pricing
  price decimal(10,2)
  
  isActive boolean [default: true]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    collegeId
    isbn
    accessionNumber
    title
    author
    category
    subject
  }
}

Table library_issues {
  id uuid [primary key, default: `gen_random_uuid()`]
  bookId uuid [not null, ref: > library_books.id]
  studentId uuid [not null, ref: > students.id]
  
  issueDate date [not null]
  dueDate date [not null]
  returnDate date
  
  // Issue details
  issuedBy uuid [not null, ref: > users.id]
  returnedTo uuid [ref: > users.id]
  
  // Status
  status issue_status [default: 'issued']
  
  // Fine calculation
  fineAmount decimal(8,2) [default: 0]
  finePaid boolean [default: false]
  fineWaivedBy uuid [ref: > users.id]
  
  // Remarks
  issueRemarks text
  returnRemarks text
  
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    bookId
    studentId
    issueDate
    dueDate
    status
    returnDate
  }
}

Table classrooms {
  id uuid [primary key, default: `gen_random_uuid()`]
  collegeId uuid [not null, ref: > colleges.id]
  
  roomNumber varchar(20) [not null]
  building varchar(100)
  floor integer
  capacity integer [not null]
  
  // Room type and facilities
  roomType classroom_type [not null]
  facilities json [default: '[]']
  
  // Equipment
  hasProjector boolean [default: false]
  hasAC boolean [default: false]
  hasSmartBoard boolean [default: false]
  
  isActive boolean [default: true]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    collegeId
    (collegeId, roomNumber) [unique]
    roomType
    capacity
  }
}

Table timetable {
  id uuid [primary key, default: `gen_random_uuid()`]
  collegeId uuid [not null, ref: > colleges.id]
  sectionId uuid [not null, ref: > sections.id]
  courseId uuid [not null, ref: > courses.id]
  facultyId uuid [not null, ref: > faculty.id]
  classroomId uuid [ref: > classrooms.id]
  
  // Time details
  dayOfWeek integer [not null, note: '1=Monday, 7=Sunday']
  startTime time [not null]
  endTime time [not null]
  period integer [not null]
  
  // Academic details
  academicYear varchar(10) [not null]
  semester integer [not null]
  
  // Class type
  classType class_type [default: 'theory']
  
  // Effective dates
  effectiveFrom date [not null]
  effectiveTo date
  
  isActive boolean [default: true]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    collegeId
    sectionId
    courseId
    facultyId
    dayOfWeek
    period
    academicYear
    semester
  }
}

Table transactions {
  id uuid [primary key, default: `gen_random_uuid()`]
  collegeId uuid [not null, ref: > colleges.id]
  
  // Transaction type and category
  type transaction_type [not null]
  category transaction_category [not null]
  
  // Amount in paisa for precision
  amount bigint [not null]
  description varchar(500) [not null]
  
  // Student reference for fee payments
  studentId uuid [ref: > students.id]
  
  // Payment details
  paymentMethod payment_method [not null]
  status transaction_status [default: 'pending']
  
  // Dates
  dueDate timestamp
  paidDate timestamp
  
  // Reference numbers
  referenceNumber varchar(50) [not null, unique]
  bankReferenceNumber varchar(100)
  receiptNumber varchar(50)
  
  // Academic details
  academicYear varchar(10)
  semester integer
  
  // Processing details
  processedById uuid [ref: > users.id]
  approvedBy uuid [ref: > users.id]
  approvedAt timestamp
  
  // Additional details
  notes text
  
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]

  indexes {
    collegeId
    type
    category
    studentId
    status
    referenceNumber
    paidDate
    academicYear
    dueDate
  }
}

// ============================================
// MONGODB COLLECTIONS (Unstructured Data)
// ============================================

Table analytics [note: 'MongoDB Collection - Analytics and reporting data'] {
  _id ObjectId [primary key]
  collegeId varchar [note: 'UUID from PostgreSQL']
  type analytics_type [not null]
  period analytics_period [not null]
  startDate timestamp [not null]
  endDate timestamp [not null]
  data json [not null, note: 'Flexible analytics data structure']
  generatedBy varchar [not null, note: 'User UUID from PostgreSQL']
  title varchar [not null]
  description varchar
  status analytics_status [default: 'completed']
  processingTime integer [note: 'in milliseconds']
  isPublic boolean [default: false]
  sharedWith json [note: 'Array of user UUIDs']
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]
}

Table configurations [note: 'MongoDB Collection - Flexible settings and configurations'] {
  _id ObjectId [primary key]
  scope config_scope [not null]
  entityId varchar [note: 'UUID from PostgreSQL (college, department, or user)']
  key varchar [not null]
  value json [not null, note: 'Mixed data type value']
  description varchar
  dataType config_data_type [not null]
  isRequired boolean [default: false]
  defaultValue json [note: 'Mixed data type default value']
  isPublic boolean [default: false]
  canBeModified boolean [default: true]
  version integer [default: 1]
  createdBy varchar [not null, note: 'User UUID from PostgreSQL']
  lastModifiedBy varchar [note: 'User UUID from PostgreSQL']
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]
}

Table file_uploads [note: 'MongoDB Collection - File upload schema for documents, images, assignments, etc.'] {
  _id ObjectId [primary key]
  entityType file_entity_type [not null]
  entityId varchar [not null, note: 'UUID from PostgreSQL']
  originalName varchar [not null]
  fileName varchar [not null, unique]
  filePath varchar [not null]
  fileSize integer [not null]
  mimeType varchar [not null]
  fileType file_type [not null]
  category file_category [not null]
  description varchar
  tags json [note: 'Array of strings']
  uploadedBy varchar [not null, note: 'User UUID from PostgreSQL']
  uploadedAt timestamp [default: `now()`]
  isPublic boolean [default: false]
  allowedRoles json [note: 'Array of user roles']
  isActive boolean [default: true]
  version integer [default: 1]
  parentFileId ObjectId [note: 'Reference to parent file for versioning']
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]
}

Table notifications [note: 'MongoDB Collection - Notifications system'] {
  _id ObjectId [primary key]
  recipientId varchar [not null, note: 'User UUID from PostgreSQL']
  recipientType notification_recipient_type [default: 'user']
  senderId varchar [not null, note: 'User UUID from PostgreSQL']
  collegeId varchar [note: 'UUID from PostgreSQL']
  title varchar(200) [not null]
  message varchar(1000) [not null]
  type notification_type [not null]
  priority notification_priority [default: 'normal']
  status notification_status [default: 'sent']
  channels json [note: 'Array of delivery channels']
  readAt timestamp
  actionUrl varchar
  actionText varchar
  expiresAt timestamp
  metadata json [note: 'Flexible metadata structure']
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]
}

Table system_logs [note: 'MongoDB Collection - System logs for audit trail, user actions, system events'] {
  _id ObjectId [primary key]
  level log_level [default: 'info']
  event varchar [not null]
  action varchar [not null]
  userId varchar [note: 'UUID from PostgreSQL']
  userRole user_role
  collegeId varchar [note: 'UUID from PostgreSQL']
  ip varchar
  userAgent varchar
  method varchar
  url varchar
  data json [note: 'Flexible data structure']
  error json [note: 'Error details with message, stack, code']
  duration integer [note: 'in milliseconds']
  status log_status [default: 'success']
  createdAt timestamp [default: `now()`, note: 'TTL index - auto-delete after 30 days']
  updatedAt timestamp [default: `now()`]
}

Table academic_calendar [note: 'MongoDB Collection - Flexible academic calendar and events'] {
  _id ObjectId [primary key]
  collegeId varchar [not null, note: 'UUID from PostgreSQL']
  title varchar(200) [not null]
  description text
  eventType calendar_event_type [not null]
  startDate timestamp [not null]
  endDate timestamp
  isAllDay boolean [default: false]
  location varchar(200)
  organizer varchar [note: 'User UUID from PostgreSQL']
  attendees json [note: 'Array of user UUIDs']
  reminderSettings json [note: 'Reminder configuration']
  metadata json [note: 'Flexible event data']
  status event_status [default: 'scheduled']
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]
}

Table announcements [note: 'MongoDB Collection - College announcements and notices'] {
  _id ObjectId [primary key]
  collegeId varchar [not null, note: 'UUID from PostgreSQL']
  authorId varchar [not null, note: 'User UUID from PostgreSQL']
  title varchar(300) [not null]
  content text [not null]
  announcementType announcement_type [not null]
  targetAudience json [note: 'Array of roles/departments/sections']
  priority announcement_priority [default: 'normal']
  publishDate timestamp [not null]
  expiryDate timestamp
  attachments json [note: 'Array of file references']
  isPublished boolean [default: false]
  viewCount integer [default: 0]
  metadata json [note: 'Additional announcement data']
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]
}

