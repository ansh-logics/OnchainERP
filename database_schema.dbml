// ============================================
// RELATIONSHIPS SUMMARY
// ============================================

// PostgreSQL Relationships:
// Core System
// - colleges -> users (adminId)
// - departments -> colleges (collegeId)
// - departments -> users (hodId) [optional]
// - courses -> colleges (collegeId)
// - courses -> departments (departmentId)
// - courses -> faculty (primaryFacultyId) [optional]
// - faculty -> users (userId)
// - faculty -> colleges (collegeId)
// - faculty -> departments (departmentId)
// - students -> users (userId)
// - students -> colleges (collegeId)
// - students -> departments (departmentId)
// - students -> sections (sectionId) [optional]
// - sections -> colleges (collegeId)
// - sections -> departments (departmentId)
// - sections -> faculty (classTeacherId) [optional]
// - sections -> classrooms (defaultClassroomId) [optional]

// Academic Operations
// - attendance -> students (studentId)
// - attendance -> courses (courseId)
// - attendance -> faculty (facultyId, markedBy)
// - assignments -> courses (courseId)
// - assignments -> faculty (facultyId)
// - assignment_submissions -> assignments (assignmentId)
// - assignment_submissions -> students (studentId)
// - exams -> colleges (collegeId)
// - exams -> courses (courseId)
// - exams -> exam_halls (examHallId) [optional]
// - exams -> faculty (invigilatorId) [optional]
// - exam_results -> exams (examId)
// - exam_results -> students (studentId)

// Hostel Management
// - hostels -> colleges (collegeId)
// - hostels -> faculty (wardenId) [optional]
// - hostel_rooms -> hostels (hostelId)
// - hostel_allocations -> students (studentId)
// - hostel_allocations -> hostels (hostelId)
// - hostel_allocations -> hostel_rooms (roomId)
// - students -> hostels (hostelId) [optional]
// - students -> hostel_rooms (roomId) [optional]

// Library Management
// - library_books -> colleges (collegeId)
// - library_issues -> library_books (bookId)
// - library_issues -> students (studentId)
// - library_issues -> users (issuedBy, returnedTo)

// Infrastructure
// - labs -> colleges (collegeId)
// - labs -> departments (departmentId)
// - labs -> faculty (labInchargeId) [optional]
// - classrooms -> colleges (collegeId)
// - exam_halls -> colleges (collegeId)

// Academic Scheduling
// - timetable -> colleges (collegeId)
// - timetable -> sections (sectionId)
// - timetable -> courses (courseId)
// - timetable -> faculty (facultyId)
// - timetable -> classrooms (classroomId) [optional]

// Financial
// - transactions -> colleges (collegeId)
// - transactions -> students (studentId) [optional]
// - transactions -> users (processedById, approvedBy) [optional]

// MongoDB Collections reference PostgreSQL UUIDs:
// - All MongoDB collections use UUID strings to reference PostgreSQL entities
// - This creates a loose coupling between the relational and document stores
// - Referential integrity is maintained at the application level
// - Analytics, logs, files, notifications, and configurations are stored in MongoDB
// - Academic calendar and announcements use MongoDB for flexible schema