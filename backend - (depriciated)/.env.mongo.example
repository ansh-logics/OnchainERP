# MongoDB Migration Environment Variables
# Copy these to your .env file or set them in your environment

# Database Configuration
USE_MONGODB=true
MONGODB_URI=mongodb://localhost:27017/onchain-erp

# Sync Configuration (for dual-database mode)
DB_SYNC_ENABLED=true
DB_SYNC_DIRECTION=mongo-primary
DB_SYNC_FAIL_SILENTLY=true
DB_SYNC_LOG_LEVEL=info

# Migration Configuration
CONFIRM_MIGRATION=false

# Development Flags
NODE_ENV=development
DB_SYNC=false

# Existing PostgreSQL Configuration (keep for fallback)
POSTGRES_DB=onchain_erp
POSTGRES_USER=anshbhatt
POSTGRES_PASSWORD=9013
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
