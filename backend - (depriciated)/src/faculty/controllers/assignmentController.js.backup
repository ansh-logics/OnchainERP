const asyncHandler = require('express-async-handler');
const { Assignment, AssignmentSubmission, Student, Section, Faculty, User, Timetable, Department } = require('../../shared/db/models');
const { Op } = require('sequelize');
const multer = require('multer');
const path = require('path');
const fs = require('fs');
const LoggingService = require('../../shared/services/LoggingService');

// Configure multer for file uploads
const storage = multer.diskStorage({
  destination: (req, file, cb) => {
    const uploadPath = path.join(__dirname, '../../../uploads/assignments');
    // Create directory if it doesn't exist
    if (!fs.existsSync(uploadPath)) {
      fs.mkdirSync(uploadPath, { recursive: true });
    }
    cb(null, uploadPath);
  },
  filename: (req, file, cb) => {
    // Generate unique filename
    const uniqueSuffix = Date.now() + '-' + Math.round(Math.random() * 1E9);
    cb(null, file.fieldname + '-' + uniqueSuffix + path.extname(file.originalname));
  }
});

const upload = multer({
  storage: storage,
  limits: {
    fileSize: 10 * 1024 * 1024, // 10MB limit
  },
  fileFilter: (req, file, cb) => {
    // Allow common file types
    const allowedTypes = /jpeg|jpg|png|gif|pdf|doc|docx|txt|zip|rar|ppt|pptx|xls|xlsx/;
    const extname = allowedTypes.test(path.extname(file.originalname).toLowerCase());
    const mimetype = allowedTypes.test(file.mimetype);

    if (mimetype && extname) {
      return cb(null, true);
    } else {
      cb(new Error('Only allowed file types are permitted!'));
    }
  }
}).array('files', 5); // Allow up to 5 files

// @desc    Get sections assigned to faculty
// @route   GET /api/faculty-services/assignments/sections
// @access  Private (Faculty)  
const getFacultySections = asyncHandler(async (req, res) => {
  console.log('🔍 getFacultySections called');
  console.log('🔍 User:', req.user);

  // Temporary: For testing, let's return all sections if no authenticated user
  if (!req.user || !req.user.id) {
    console.log('⚠️ No authenticated user, returning all sections for testing');
    try {
      const allSections = await Section.findAll({
        where: { isActive: true },
        attributes: ['id', 'name', 'code', 'batch', 'semester', 'currentStrength'],
        include: [{
          model: Department,
          as: 'department',
          attributes: ['id', 'name', 'code']
        }],
        limit: 10 // Limit for testing
      });

      return res.status(200).json({
        success: true,
        count: allSections.length,
        data: allSections,
        message: 'Test data - authentication bypassed'
      });
    } catch (error) {
      console.error('Error fetching test sections:', error);
      return res.status(500).json({
        success: false,
        message: 'Failed to fetch test sections'
      });
    }
  }

  const facultyUserId = req.user.id;

  // Get faculty profile
  const faculty = await Faculty.findOne({
    where: { userId: facultyUserId }
  });

  if (!faculty) {
    return res.status(404).json({
      success: false,
      message: 'Faculty profile not found'
    });
  }

  try {
    // Get unique sections assigned to this faculty from timetable
    const timetableEntries = await Timetable.findAll({
      where: {
        facultyId: faculty.id,
        isActive: true
      },
      include: [
        {
          model: Section,
          as: 'section',
          attributes: ['id', 'name', 'code', 'batch', 'semester', 'currentStrength'],
          include: [{
            model: Department,
            as: 'department',
            attributes: ['id', 'name', 'code']
          }]
        }
      ]
    });

    // Extract unique sections
    const sectionMap = new Map();
    timetableEntries.forEach(entry => {
      if (entry.section && !sectionMap.has(entry.section.id)) {
        sectionMap.set(entry.section.id, entry.section);
      }
    });

    const uniqueSections = Array.from(sectionMap.values());

    // If no sections found in timetable, try to get all sections from faculty's department
    if (uniqueSections.length === 0) {
      const departmentSections = await Section.findAll({
        where: {
          departmentId: faculty.departmentId,
          isActive: true
        },
        attributes: ['id', 'name', 'code', 'batch', 'semester', 'currentStrength'],
        include: [{
          model: Department,
          as: 'department',
          attributes: ['id', 'name', 'code']
        }]
      });
      
      uniqueSections.push(...departmentSections);
    }

    await LoggingService.log({
      level: 'info',
      message: `Faculty ${faculty.id} accessed sections list`,
      userId: req.user.id,
      details: {
        sectionsCount: uniqueSections.length,
        source: uniqueSections.length > 0 ? 'timetable' : 'department'
      }
    });

    res.status(200).json({
      success: true,
      count: uniqueSections.length,
      data: uniqueSections
    });

  } catch (error) {
    console.error('Error fetching faculty sections:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to fetch sections'
    });
  }
});

// @desc    Get all assignments created by faculty
// @route   GET /api/faculty-services/assignments
// @access  Private (Faculty) - temporarily public for development
const getAllFacultyAssignments = asyncHandler(async (req, res) => {
  try {
    let facultyUserId;
    
    if (req.user && req.user.id) {
      // Authenticated user
      facultyUserId = req.user.id;
    } else {
      // Development mode: use first available faculty
      console.log('⚠️ Development mode: Getting assignments for first faculty');
      const firstFaculty = await Faculty.findOne({ 
        include: [{
          model: User,
          as: 'user',
          attributes: ['id']
        }]
      });
      
      if (firstFaculty && firstFaculty.user) {
        facultyUserId = firstFaculty.user.id;
      } else {
        return res.status(404).json({
          success: false,
          message: 'No faculty found'
        });
      }
    }

    // Get faculty profile
    const faculty = await Faculty.findOne({
      where: { userId: facultyUserId }
    });

    if (!faculty) {
      return res.status(404).json({
        success: false,
        message: 'Faculty profile not found'
      });
    }

    // Get all assignments created by this faculty
    const assignments = await Assignment.findAndCountAll({
      where: {
        facultyId: faculty.id,
        isActive: true
      },
      include: [
        {
          model: Section,
          as: 'section',
          attributes: ['id', 'name', 'code', 'batch'],
          include: [{
            model: Department,
            as: 'department',
            attributes: ['name', 'code']
          }]
        },
        {
          model: AssignmentSubmission,
          as: 'submissions',
          attributes: ['id', 'studentId', 'submissionDate', 'status'],
          required: false
        }
      ],
      order: [['createdAt', 'DESC']]
    });

    // Add submission statistics to each assignment
    const assignmentsWithStats = assignments.rows.map(assignment => {
      const totalSubmissions = assignment.submissions ? assignment.submissions.length : 0;
      
      return {
        ...assignment.toJSON(),
        submissionStats: {
          total: totalSubmissions,
          pending: totalSubmissions > 0 ? assignment.submissions.filter(sub => sub.status === 'submitted').length : 0,
          graded: totalSubmissions > 0 ? assignment.submissions.filter(sub => sub.status === 'graded').length : 0
        }
      };
    });

    console.log(`Found ${assignments.count} assignments for faculty ${faculty.id}`);

    res.status(200).json({
      success: true,
      count: assignments.count,
      data: assignmentsWithStats,
      pagination: {
        total: assignments.count,
        pages: 1
      }
    });

  } catch (error) {
    console.error('Error fetching faculty assignments:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to fetch assignments'
    });
  }
});

